{
  "name": "relay",
  "version": "1.0.0",
  "description": "Production-grade real-time chat — Node.js, Express, ws, MySQL, hand-built ring buffer, role-based JWT auth, analytics, moderation with audit logs.",
  "main": "src/server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
