# ── Server ────────────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── MySQL (local dev) ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=relay

# On Railway: set MYSQL_URL=${{ MySQL.MYSQL_URL }} instead
# (a connection string overrides the individual vars)
# MYSQL_URL=

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_64_char_random_string
JWT_EXPIRES_IN=7d
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── Seed admin (npm run db:seed) ──────────────────────────
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@relay.local
ADMIN_PASSWORD=ChangeMe123

# ── Chat limits ───────────────────────────────────────────
BUFFER_CAPACITY=200
DAILY_MESSAGE_LIMIT=500
MESSAGE_MAX_LENGTH=2000

# ── HTTP rate limits (per window) ─────────────────────────
RATE_WINDOW_MINUTES=15
RATE_MAX_GENERAL=300
RATE_MAX_ROOMS=20
RATE_MAX_AUTH=10
